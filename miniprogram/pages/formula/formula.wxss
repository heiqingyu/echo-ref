/* 公式详情页：结果行与清空按钮（自原「其他计算」页迁入） */

.calc-out {
  display: flex;
  align-items: flex-start;
  background: #eff4ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}

.calc-out--idle {
  background: #f3f4f6;
}

.calc-out__lbl {
  font-size: 22rpx;
  color: #6b7280;
  margin-right: 16rpx;
  line-height: 1.7;
  flex-shrink: 0;
}

.calc-out__v {
  font-size: 26rpx;
  color: #1d4ed8;
  font-weight: 600;
  line-height: 1.7;
  word-break: break-all;
}

.calc-out--idle .calc-out__v {
  color: #9ca3af;
  font-weight: 400;
}

.clear-btn {
  margin: 24rpx 0;
  background: #ffffff;
  color: #6b7280;
  font-size: 28rpx;
  border-radius: 14rpx;
}

.clear-btn::after {
  border: 1rpx solid #e3e6ea;
}

/* ── 评估类内容块 ── */
.fx-h {
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2329;
  margin: 24rpx 0 10rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid #2563eb;
  line-height: 1.4;
}

.fx-text {
  font-size: 25rpx;
  color: #374151;
  line-height: 1.65;
  margin: 10rpx 0;
}

.fx-note {
  font-size: 24rpx;
  color: #92400e;
  background: #fffbeb;
  border-left: 6rpx solid #f59e0b;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin: 12rpx 0;
  line-height: 1.6;
}

.fx-formula {
  font-size: 25rpx;
  color: #1d4ed8;
  background: #eff4ff;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin: 12rpx 0;
  line-height: 1.6;
}

/* ── 表格（与瓣膜页同款） ── */
.vtbl {
  margin: 14rpx 0;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  overflow: hidden;
}

.vtbl__r {
  display: flex;
  border-top: 1rpx solid #f0f1f3;
  background: #fff;
}

.vtbl__r:first-child {
  border-top: 0;
}

.vtbl__r--h {
  background: #eef2ff;
  font-weight: 600;
  color: #374151;
}

.vtbl__c {
  flex: 1 1 0;
  min-width: 0;
  padding: 12rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.45;
  box-sizing: border-box;
  word-break: break-word;
}

.vtbl--2 .vtbl__c:first-child {
  flex: 0 0 32%;
  font-weight: 500;
}

.vtbl--3 .vtbl__c:first-child,
.vtbl--4 .vtbl__c:first-child,
.vtbl--5 .vtbl__c:first-child {
  font-weight: 500;
  color: #374151;
}

/* ── 本条目引用 ── */
.ref-item {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f1f3;
}

.ref-item:first-of-type {
  border-top: none;
}

.ref-item__id {
  flex: none;
  width: 62rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #1d4ed8;
  background: #eff4ff;
  border-radius: 8rpx;
}

.ref-item__body {
  flex: 1;
  min-width: 0;
}

.ref-item__zh {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.5;
}

.ref-item__where {
  font-size: 21rpx;
  color: #8a9099;
  margin-top: 2rpx;
  line-height: 1.5;
}
