/* 公式详情页：结果行与清空按钮（自原「其他计算」页迁入） */

.calc-out {
  display: flex;
  align-items: flex-start;
  background: #eff4ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}

.calc-out--idle {
  background: #f3f4f6;
}

/* ★ v1.8.3 合并页：小节名放上一行，结果独占下一行（横排会把长结果挤成窄条） */
.calc-out--multi {
  display: block;
}

.calc-out--multi .calc-out__lbl {
  display: block;
  margin: 0 0 4rpx;
  font-size: 21rpx;
  color: #4b5563;
  font-weight: 600;
}

.calc-out--multi .calc-out__v {
  display: block;
  font-size: 25rpx;
}

.calc-out__lbl {
  font-size: 22rpx;
  color: #6b7280;
  margin-right: 16rpx;
  line-height: 1.7;
  flex-shrink: 0;
}

.calc-out__v {
  font-size: 26rpx;
  color: #1d4ed8;
  font-weight: 600;
  line-height: 1.7;
  /* ★ v1.8.3：break-all 会把「（>1200）」从数字中间劈开，改用放不下时才断词 */
  overflow-wrap: break-word;
  word-break: normal;
}

.calc-out--idle .calc-out__v {
  color: #9ca3af;
  font-weight: 400;
}

.clear-btn {
  margin: 24rpx 0;
  background: #ffffff;
  color: #6b7280;
  font-size: 28rpx;
  border-radius: 14rpx;
}

.clear-btn::after {
  border: 1rpx solid #e3e6ea;
}

/* ── 评估类内容块 ── */
.fx-h {
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2329;
  margin: 24rpx 0 10rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid #2563eb;
  line-height: 1.4;
}

/* 行内加粗（正文里的 **重点**） */
.fx-b {
  font-weight: 700;
  color: #111827;
}

/* ── 本文缩写（v1.11.2） ── */
.abbr {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 18rpx;
  margin: 14rpx 0 4rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #f3f5f8;
  font-size: 24rpx;
  line-height: 1.55;
  color: #55606e;
}
.abbr__t {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #8a94a2;
}
.abbr__i {
  display: inline-flex;
  align-items: baseline;
}
.abbr__b {
  font-weight: 700;
  color: #1f2a37;
  margin-right: 6rpx;
}

/* ── 条目内小节导航（长条目定位用） ── */
.fx-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 16rpx 0 6rpx;
}

.fx-nav__c {
  max-width: 100%;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #6b7280;
  background: #f1f3f6;
  border-radius: 999rpx;
  white-space: nowrap;
}

.fx-nav__c--on {
  color: #ffffff;
  background: #2563eb;
}

.fx-nav__c--tap {
  background: #dbe6ff;
  color: #2563eb;
}

.fx-text {
  font-size: 25rpx;
  color: #374151;
  line-height: 1.65;
  margin: 10rpx 0;
}

.fx-note {
  font-size: 24rpx;
  color: #92400e;
  background: #fffbeb;
  border-left: 6rpx solid #f59e0b;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin: 12rpx 0;
  line-height: 1.6;
}

.fx-formula {
  font-size: 25rpx;
  color: #1d4ed8;
  background: #eff4ff;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin: 12rpx 0;
  line-height: 1.6;
}

/* ── 表格（与瓣膜页同款） ── */
.vtbl {
  margin: 14rpx 0;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  overflow: hidden;
}

.vtbl__r {
  display: flex;
  border-top: 1rpx solid #f0f1f3;
  background: #fff;
}

.vtbl__r:first-child {
  border-top: 0;
}

.vtbl__r--h {
  background: #eef2ff;
  font-weight: 600;
  color: #374151;
}

.vtbl__c {
  flex: 1 1 0;
  min-width: 0;
  padding: 12rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.45;
  box-sizing: border-box;
  word-break: break-word;
}

.vtbl--2 .vtbl__c:first-child {
  flex: 0 0 32%;
  font-weight: 500;
}

.vtbl--3 .vtbl__c:first-child,
.vtbl--4 .vtbl__c:first-child,
.vtbl--5 .vtbl__c:first-child {
  font-weight: 500;
  color: #374151;
}

/* ── 本条目引用 ── */
.ref-item {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f1f3;
}

.ref-item:first-of-type {
  border-top: none;
}

.ref-item__id {
  flex: none;
  width: 62rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #1d4ed8;
  background: #eff4ff;
  border-radius: 8rpx;
}

.ref-item__body {
  flex: 1;
  min-width: 0;
}

.ref-item__zh {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.5;
}

.ref-item__where {
  font-size: 21rpx;
  color: #5d6673;
  margin-top: 2rpx;
  line-height: 1.5;
}

/* ── 「相关计算」胶囊：点了跳到公式集对应计算器 ── */
.chiprow {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx 0 12rpx;
}

.chip {
  max-width: 100%;
  margin: 8rpx 12rpx 0 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.07);
  border: 1rpx solid rgba(37, 99, 235, 0.26);
}

.chip:active {
  background: rgba(37, 99, 235, 0.18);
}

/* ── 相关内容：条目间交叉引用胶囊（2026-10-22） ── */
.rel-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.rel-chip {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #7c3aed;
  background: #f5f0ff;
  border: 1rpx solid #e6d9ff;
  border-radius: 999rpx;
}

.rel-chip:active {
  background: #e6d9ff;
}

/* ── 页尾：跳转其他页面 ── */
.pagefoot {
  margin: 28rpx 0 12rpx;
}

.pagefoot__hd {
  margin: 0 8rpx 16rpx;
  font-size: 24rpx;
  color: #8a9099;
}

.pagefoot__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pagefoot__i {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  background: #ffffff;
  border: 1rpx solid #e6e8ec;
  border-radius: 16rpx;
}

.pagefoot__i:active {
  background: #eff4ff;
}

.pagefoot__t {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2329;
}

.pagefoot__d {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a9099;
}
