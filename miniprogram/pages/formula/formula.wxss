/* 公式详情页：结果行与清空按钮（自原「其他计算」页迁入） */

.calc-out {
  display: flex;
  align-items: flex-start;
  background: #eff4ff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
}

.calc-out--idle {
  background: #f3f4f6;
}

/* 回到顶部（长条目详情页，2026-11-01） */
.totop {
  position: fixed;
  right: 28rpx;
  bottom: 140rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .97);
  border: 1rpx solid #dbe3ec;
  color: #2563eb;
  font-size: 40rpx;
  line-height: 86rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, .16);
  z-index: 60;
}

/* ★ v1.8.3 合并页：小节名放上一行，结果独占下一行（横排会把长结果挤成窄条） */
.calc-out--multi {
  display: block;
}

.calc-out--multi .calc-out__lbl {
  display: block;
  margin: 0 0 4rpx;
  font-size: 21rpx;
  color: #4b5563;
  font-weight: 600;
}

.calc-out--multi .calc-out__v {
  display: block;
  font-size: 25rpx;
}

.calc-out__lbl {
  font-size: 22rpx;
  color: #6b7280;
  margin-right: 16rpx;
  line-height: 1.7;
  flex-shrink: 0;
}

.calc-out__v {
  font-size: 26rpx;
  color: #1d4ed8;
  font-weight: 600;
  line-height: 1.7;
  /* ★ v1.8.3：break-all 会把「（>1200）」从数字中间劈开，改用放不下时才断词 */
  overflow-wrap: break-word;
  word-break: normal;
}

.calc-out--idle .calc-out__v {
  color: #9ca3af;
  font-weight: 400;
}

.clear-btn {
  margin: 24rpx 0;
  background: #ffffff;
  color: #6b7280;
  font-size: 28rpx;
  border-radius: 14rpx;
}

.clear-btn::after {
  border: 1rpx solid #e3e6ea;
}

/* ── 评估类内容块 ── */
.fx-h {
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2329;
  margin: 24rpx 0 10rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid #2563eb;
  line-height: 1.4;
}

/* 注：v1.15.4 起旧的小节胶囊条（.fx-nav / .fx-nav__c）已整段删除，
   换成下面这套 .ftoc 悬浮目录；其他页面（calculators / segments）仍在用 .fx-nav，别跨页删。 */

/* 行内加粗（正文里的 **重点**） */
.fx-b {
  font-weight: 700;
  color: #111827;
}

/* ── 本文缩写（v1.11.2） ── */
.abbr {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 8rpx 18rpx;
  margin: 14rpx 0 4rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #f3f5f8;
  font-size: 24rpx;
  line-height: 1.55;
  color: #55606e;
}
.abbr__t {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #8a94a2;
}
.abbr__i {
  display: inline-flex;
  align-items: baseline;
}
.abbr__b {
  font-weight: 700;
  color: #1f2a37;
  margin-right: 6rpx;
}

/* ── 悬浮小节目录（v1.15.4）──
   默认只是一个圆点贴右侧，不占首屏高度；点开是带序号的小节列表，当前节高亮。
   ★ 2026-11-05 位置重排：原来 bottom 180rpx，与「回到顶部」(.totop, 140rpx + 88rpx)
     整整重叠 48rpx，两个圆叠成一团（用户截图反馈）。现在目录圆点固定排在回顶上方：
     回顶 140rpx → 目录 264rpx（间隙 36rpx）。 */
.ftoc {
  position: fixed;
  right: 24rpx;
  bottom: calc(264rpx + env(safe-area-inset-bottom));
  z-index: 60;
}

.ftoc__dot {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(37, 99, 235, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.24);
}

.ftoc__dot--on,
.ftoc__dot--tap { background: #1d4ed8; }

.ftoc__ic {
  color: #ffffff;
  font-size: 38rpx;
  line-height: 1;
}

.ftoc__mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.2);
}

.ftoc__panel {
  position: absolute;
  right: 0;
  bottom: 108rpx;
  width: 460rpx;
  max-height: 64vh;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 44rpx rgba(15, 23, 42, 0.3);
}

.ftoc__hd {
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  color: #6b7280;
  border-bottom: 1rpx solid #eef2f7;
}

.ftoc__list { max-height: 58vh; }

.ftoc__i {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f4f6f9;
}

.ftoc__i--on { background: #eff4ff; }
.ftoc__i--tap { background: #e5edff; }

.ftoc__no {
  flex: none;
  width: 36rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.ftoc__i--on .ftoc__no { color: #2563eb; }

.ftoc__t {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.45;
  color: #1f2329;
}

.ftoc__i--on .ftoc__t {
  color: #2563eb;
  font-weight: 600;
}

/* ★ v1.14.2：正文按自然段切分（js 里 EX.paraSplit），行高与段间距同步放大 */
.fx-text {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.8;
  margin: 12rpx 0 14rpx;
}

.fx-p {
  margin: 0 0 16rpx;
  line-height: 1.8;
}

.fx-p:last-child {
  margin-bottom: 0;
}

/* ①②③ / 1. 这类并列项：首行顶格、续行缩进（悬挂缩进） */
.fx-p--hang {
  padding-left: 1.5em;
  text-indent: -1.5em;
}

.fx-note {
  font-size: 24rpx;
  color: #92400e;
  background: #fffbeb;
  border-left: 6rpx solid #f59e0b;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin: 12rpx 0;
  line-height: 1.6;
}

/* ★ v1.14.2：色块里的长 note 也分段 */
.fx-note .fx-np {
  margin: 0 0 12rpx;
  line-height: 1.72;
}

.fx-note .fx-np:last-child {
  margin-bottom: 0;
}

.fx-formula {
  font-size: 25rpx;
  color: #1d4ed8;
  background: #eff4ff;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  margin: 12rpx 0;
  line-height: 1.6;
}

/* ── 表格（与瓣膜页同款） ── */
.vtbl {
  margin: 14rpx 0;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  overflow: hidden;
}

.vtbl__r {
  display: flex;
  border-top: 1rpx solid #f0f1f3;
  background: #fff;
}

.vtbl__r:first-child {
  border-top: 0;
}

.vtbl__r--h {
  background: #eef2ff;
  font-weight: 600;
  color: #374151;
}

.vtbl__c {
  flex: 1 1 0;
  min-width: 0;
  padding: 12rpx 12rpx;
  font-size: 22rpx;
  line-height: 1.45;
  box-sizing: border-box;
  word-break: break-word;
}

.vtbl--2 .vtbl__c:first-child {
  flex: 0 0 32%;
  font-weight: 500;
}

.vtbl--3 .vtbl__c:first-child,
.vtbl--4 .vtbl__c:first-child,
.vtbl--5 .vtbl__c:first-child {
  font-weight: 500;
  color: #374151;
}

/* ★ v1.14.2：5 列表格在 375px 屏上每列仅 ~70px，压字号 + 收首列 */
.vtbl--5 .vtbl__c {
  padding: 10rpx 8rpx;
  font-size: 21rpx;
  line-height: 1.42;
}

.vtbl--5 .vtbl__c:first-child {
  flex: 0 0 17%;
}

/* 6 列仅作兜底（内容已尽量压到 ≤4 列） */
.vtbl--6 .vtbl__c {
  padding: 8rpx 6rpx;
  font-size: 20rpx;
  line-height: 1.4;
}

.vtbl--6 .vtbl__c:first-child {
  flex: 0 0 14%;
}

/* ── 本条目引用 ── */
.ref-item {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f1f3;
}

.ref-item:first-of-type {
  border-top: none;
}

/* 本条目引用：整行可点，跳到公式集底部文献总表（v1.11.3） */
.ref-item--jump {
  align-items: flex-start;
}

.ref-item--tap {
  background: #f5f8ff;
}

.ref-item__go {
  flex: none;
  align-self: center;
  padding-left: 8rpx;
  font-size: 22rpx;
  color: #2563eb;
  opacity: .8;
  white-space: nowrap;
}

.ref-item__id {
  flex: none;
  width: 62rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 600;
  color: #1d4ed8;
  background: #eff4ff;
  border-radius: 8rpx;
}

.ref-item__body {
  flex: 1;
  min-width: 0;
}

.ref-item__zh {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.5;
}

.ref-item__en {
  font-size: 21rpx;
  color: #5d6673;
  margin-top: 4rpx;
  line-height: 1.55;
  word-break: break-word;
}

.ref-item__where {
  font-size: 21rpx;
  color: #5d6673;
  margin-top: 2rpx;
  line-height: 1.5;
}

/* ── 「相关计算」胶囊：点了跳到公式集对应计算器 ── */
.chiprow {
  display: flex;
  flex-wrap: wrap;
  margin: 4rpx 0 12rpx;
}

.chip {
  max-width: 100%;
  margin: 8rpx 12rpx 0 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.07);
  border: 1rpx solid rgba(37, 99, 235, 0.26);
}

.chip:active {
  background: rgba(37, 99, 235, 0.18);
}

/* ── 相关内容：条目间交叉引用胶囊（2026-10-22） ── */
.rel-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.rel-chip {
  padding: 10rpx 22rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #7c3aed;
  background: #f5f0ff;
  border: 1rpx solid #e6d9ff;
  border-radius: 999rpx;
}

.rel-chip:active {
  background: #e6d9ff;
}

/* ── 页尾：跳转其他页面 ── */
.pagefoot {
  margin: 28rpx 0 12rpx;
}

.pagefoot__hd {
  margin: 0 8rpx 16rpx;
  font-size: 24rpx;
  color: #8a9099;
}

.pagefoot__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.pagefoot__i {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  background: #ffffff;
  border: 1rpx solid #e6e8ec;
  border-radius: 16rpx;
}

.pagefoot__i:active {
  background: #eff4ff;
}

.pagefoot__t {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: #1f2329;
}

.pagefoot__d {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a9099;
}
