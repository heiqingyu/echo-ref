<view class="page-wrap">

  <view class="card">
    <view class="card__title">{{title}}</view>
    <view class="card__desc">
      BSA {{bsaText}} m²（来自「EF·参考值」页）· 按{{sexLabel}}参考区间判读 · 留空跳过
    </view>

    <!-- 条目内小节导航：长条目滚到中间容易迷路，点胶囊直接定位到该节 -->
    <view wx:if="{{toc.length}}" class="fx-nav">
      <view wx:for="{{toc}}" wx:key="id" wx:for-item="sec"
            class="fx-nav__c {{curSec === sec.id ? 'fx-nav__c--on' : ''}}"
            data-id="{{sec.id}}" hover-class="fx-nav__c--tap" bindtap="onJumpSec">{{sec.t}}</view>
    </view>

    <!-- 评估类内容（extra-data）或计算条目的评分细则表（calc-groups 的 blocks） -->
    <block wx:if="{{blocks.length > 0}}">
      <block wx:for="{{blocks}}" wx:key="index" wx:for-item="b">

        <view wx:if="{{b.kind === 'h'}}" class="fx-h" id="sec-{{b.secIdx}}">
          <text wx:for="{{b.segs}}" wx:key="index" wx:for-item="sg"
                class="{{sg.b ? 'fx-b' : ''}}">{{sg.t}}</text>
        </view>

        <view wx:elif="{{b.kind === 'table'}}" class="vtbl vtbl--{{b.cols}}">
          <view class="vtbl__r vtbl__r--h">
            <text class="vtbl__c" wx:for="{{b.heads}}" wx:for-item="h" wx:for-index="hi" wx:key="hi"><text
                  wx:for="{{h}}" wx:for-item="sg" wx:for-index="hsi" wx:key="hsi"
                  class="{{sg.b ? 'fx-b' : ''}}">{{sg.t}}</text></text>
          </view>
          <view class="vtbl__r" wx:for="{{b.rows}}" wx:for-item="r" wx:for-index="ri" wx:key="ri">
            <text class="vtbl__c" wx:for="{{r}}" wx:for-item="cell" wx:for-index="ci" wx:key="ci"><text
                  wx:for="{{cell}}" wx:for-item="sg" wx:for-index="si" wx:key="si"
                  class="{{sg.b ? 'fx-b' : ''}}">{{sg.t}}</text></text>
          </view>
        </view>

        <block wx:elif="{{b.kind === 'note'}}">
          <view class="fx-note">
            <text wx:for="{{b.segs}}" wx:key="index" wx:for-item="sg"
                  class="{{sg.b ? 'fx-b' : ''}}">{{sg.t}}</text>
          </view>
          <!-- 相关计算：点了直接进对应计算器，性别与 BSA 由 profile 自带 -->
          <view wx:if="{{b.links.length}}" class="chiprow">
            <view wx:for="{{b.links}}" wx:key="id" class="chip"
                  data-id="{{item.id}}" bindtap="onJump">{{item.n}} ›</view>
          </view>
        </block>
        <view wx:elif="{{b.kind === 'formula'}}" class="fx-formula">
          <text wx:for="{{b.segs}}" wx:key="index" wx:for-item="sg"
                class="{{sg.b ? 'fx-b' : ''}}">{{sg.t}}</text>
        </view>
        <view wx:else class="fx-text">
          <text wx:for="{{b.segs}}" wx:key="index" wx:for-item="sg"
                class="{{sg.b ? 'fx-b' : ''}}">{{sg.t}}</text>
        </view>
      </block>
    </block>

    <!-- 输入框：评估页（二尖瓣 / 主动脉瓣）按「① 形态 / ② 狭窄 / ③ 反流」分段，
         item.head 为段标题项（无输入框），其余为普通数值输入 -->
    <block wx:for="{{inputs}}" wx:key="key">
      <view wx:if="{{item.head}}" class="fx-fgrp">{{item.head}}</view>
      <view wx:else class="field">
        <text class="field__label">{{item.name}} / {{item.unit}}</text>
        <input class="field__input" type="digit" value="{{item.value}}"
               data-idx="{{index}}" bindinput="onInput" placeholder="未填写" />
      </view>
    </block>

    <!-- 选项组（性别 / 心律 / 节段总数 等，来自 calc-groups.js 的 opts） -->
    <view wx:for="{{opts}}" wx:key="k" wx:for-item="o" class="field">
      <text class="field__label">{{o.n}}</text>
      <view class="seg">
        <view wx:for="{{o.list}}" wx:key="index" wx:for-item="c"
              class="seg__item {{optsV[o.k] === c[0] ? 'seg__item--on' : ''}}"
              data-k="{{o.k}}" data-v="{{c[0]}}" bindtap="onOpt">{{c[1]}}</view>
      </view>
    </view>

    <!-- 右心评估 / 肺高压条目的附加选项（IVC 塌陷 → 估 RAP） -->
    <block wx:if="{{gid === 'rv' || gid === 'mpap'}}">
      <view class="field">
        <text class="field__label">IVC 吸气塌陷</text>
        <view class="seg">
          <view wx:for="{{collapse}}" wx:key="v"
                class="seg__item {{collapseV === item.v ? 'seg__item--on' : ''}}"
                data-v="{{item.v}}" bindtap="onCollapse">{{item.n}}</view>
        </view>
      </view>
    </block>
    <block wx:if="{{gid === 'rv' || gid === 'mpap'}}">
      <view class="field">
        <text class="field__label">PH 支持征象（≥2 类）</text>
        <view class="seg">
          <view wx:for="{{signs}}" wx:key="v"
                class="seg__item {{signsV === item.v ? 'seg__item--on' : ''}}"
                data-v="{{item.v}}" bindtap="onSigns">{{item.n}}</view>
        </view>
      </view>
    </block>

    <view wx:if="{{noteSegs.length}}" class="note"><text wx:for="{{noteSegs}}" wx:for-item="sg"
            wx:for-index="ni" wx:key="ni"
            class="{{sg.b ? 'fx-b' : ''}}">{{sg.t}}</text></view>

    <block wx:if="{{!isReference}}">
      <view wx:if="{{hasOut}}" class="calc-out">
        <text class="calc-out__lbl">结果</text>
        <text class="calc-out__v">{{out}}</text>
      </view>
      <view wx:else class="calc-out calc-out--idle">
        <text class="calc-out__lbl">结果</text>
        <text class="calc-out__v">等待输入</text>
      </view>
    </block>
  </view>

  <button wx:if="{{!isReference}}" class="clear-btn" bindtap="onClear">清空本组输入</button>

  <view class="card" wx:if="{{rels.length}}">
    <view class="card__title">相关内容</view>
    <view class="rel-wrap">
      <view wx:for="{{rels}}" wx:key="id" class="rel-chip"
            data-id="{{item.id}}" bindtap="onRel">{{item.t}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{refs.length}}">
    <view class="card__title">本条目引用</view>
    <view wx:for="{{refs}}" wx:key="id" class="ref-item">
      <view class="ref-item__id">{{item.id}}</view>
      <view class="ref-item__body">
        <view class="ref-item__zh">{{item.zh}}</view>
        <view class="ref-item__where">{{item.where}}</view>
      </view>
    </view>
  </view>

  <view class="pagefoot">
    <view class="pagefoot__hd">继续看其他页面</view>
    <view class="pagefoot__grid">
      <view class="pagefoot__i" data-go="index" bindtap="onGo">
        <text class="pagefoot__t">EF·参考值</text><text class="pagefoot__d">EF 分级 · 正常值</text>
      </view>
      <view class="pagefoot__i" data-go="pediatric" bindtap="onGo">
        <text class="pagefoot__t">儿童 Z 值</text><text class="pagefoot__d">0–18 岁体表面积校正</text>
      </view>
      <view class="pagefoot__i" data-go="segments" bindtap="onGo">
        <text class="pagefoot__t">切面学习</text><text class="pagefoot__d">17 节段与冠脉对应</text>
      </view>
      <view class="pagefoot__i" data-go="valveana" bindtap="onGo">
        <text class="pagefoot__t">瓣膜解剖</text><text class="pagefoot__d">TEE 标准切面与探头方位</text>
      </view>
      <view class="pagefoot__i" data-go="calculators" bindtap="onGo">
        <text class="pagefoot__t">公式集目录</text><text class="pagefoot__d">72 条判读 · 48 个计算器</text>
      </view>
    </view>
  </view>

</view>
