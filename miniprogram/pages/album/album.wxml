<view class="page-wrap">

  <view wx:if="{{errText}}" class="card">
    <view class="card__title">{{errText}}</view>
    <view class="card__desc">请返回公式集重新进入。</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="card__title">{{title}}</view>
      <view class="card__desc">共 {{count}} 段 · 点击条目播放</view>
      <view wx:if="{{note}}" class="album__note">{{note}}</view>
      <view wx:if="{{links.length}}" class="album__links">
        <view wx:for="{{links}}" wx:key="url" wx:for-item="lk"
              class="album__link" hover-class="album__link--tap"
              data-url="{{lk.url}}" bindtap="onCopyLink">{{lk.n}} ↗</view>
      </view>
    </view>

    <!-- ★ v1.9.0 搜索框 + 专题导航（151 段太长，先筛再跳） -->
    <view class="album__bar">
      <view class="album__search">
        <text class="album__ico">🔍</text>
        <input class="album__input" value="{{kw}}" placeholder="搜片名 / 讲者 / 年份，如 应变、TEE、2024"
               placeholder-class="album__ph" confirm-type="search" bindinput="onKw" />
        <view wx:if="{{kw}}" class="album__clr" bindtap="onClear">✕</view>
      </view>

      <scroll-view wx:if="{{hasNav}}" class="album__nav" scroll-x scroll-with-animation
                   scroll-into-view="{{navInto}}" show-scrollbar="{{false}}">
        <view wx:for="{{chips}}" wx:key="k" wx:for-item="c" id="nc{{c.k}}"
              class="album__chip {{navOn === c.k ? 'album__chip--on' : ''}}"
              data-k="{{c.k}}" bindtap="onChip">{{c.n}}</view>
      </scroll-view>
    </view>

    <view wx:if="{{!rows.length}}" class="album__empty">没有匹配的条目，换个关键词试试。</view>

    <view class="fx-list">
      <block wx:for="{{rows}}" wx:key="id" wx:for-item="it">
        <view wx:if="{{it.g}}" class="album__g" id="ag{{it.gi}}">{{it.g}}</view>
        <view wx:else class="fx-item" hover-class="fx-item--tap"
              data-id="{{it.id}}" bindtap="onOpen">
          <view class="fx-item__main">
            <view class="fx-item__n">{{it.title}}</view>
            <view class="fx-item__d">{{it.sub}}</view>
          </view>
          <view class="fx-item__a">▶</view>
        </view>
      </block>
    </view>
  </block>

  <view class="note note--strong">
    本工具为数值计算与参考值查询工具，所有结果仅供专业参考，不作为诊断依据；
    具体诊断与治疗决策请结合临床。
  </view>
</view>
