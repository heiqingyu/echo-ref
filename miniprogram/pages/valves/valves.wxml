<view class="page-wrap">

  <!-- 瓣膜切换 -->
  <view class="vswitch">
    <view wx:for="{{tabs}}" wx:key="id"
          class="vswitch__i {{cur === item.id ? 'vswitch__i--on' : ''}}"
          data-id="{{item.id}}" bindtap="onTapTab">
      <text class="vswitch__s">{{item.label}}</text>
      <text class="vswitch__n">{{item.name}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{sec}}">
    <view class="card__title">{{sec.name}}</view>
    <view class="card__desc">{{sec.sub}}　·　{{sec.source}}</view>

    <block wx:for="{{sec.blocks}}" wx:key="index" wx:for-item="b">
      <!-- 表格 -->
      <view wx:if="{{b.kind === 'table'}}" class="vtbl">
        <view class="vtbl__r vtbl__r--h vtbl--{{b.cols}}">
          <text class="vtbl__c" wx:for="{{b.heads}}" wx:for-item="h" wx:key="index">{{h}}</text>
        </view>
        <view class="vtbl__r vtbl--{{b.cols}}" wx:for="{{b.rows}}" wx:for-item="r" wx:key="index">
          <text class="vtbl__c" wx:for="{{r}}" wx:for-item="c" wx:key="index">{{c}}</text>
        </view>
      </view>

      <view wx:elif="{{b.kind === 'h'}}" class="vblock__h">{{b.text}}</view>
      <view wx:elif="{{b.kind === 'formula'}}" class="vblock__f">{{b.text}}</view>
      <view wx:elif="{{b.kind === 'note'}}" class="note">{{b.text}}</view>
      <view wx:else class="vblock__t">{{b.text}}</view>
    </block>
  </view>

  <!-- 计算器 -->
  <view class="card" wx:if="{{sec}}">
    <view class="card__title">{{sec.calcTitle}}</view>
    <view class="card__desc">
      BSA {{bsaText}} m²（来自「参数·参考值」页）· 留空跳过；只填一项也会给出对应的单参数分级
    </view>

    <view class="row" wx:for="{{fieldRows}}" wx:key="index" wx:for-item="fr">
      <view class="field" wx:for="{{fr}}" wx:key="k" wx:for-item="f">
        <text class="field__label">{{f.n}} / {{f.u}}</text>
        <input class="field__input" type="digit" value="{{f.value}}"
               data-k="{{f.k}}" bindinput="onInput" placeholder="未填写" />
      </view>
    </view>

    <view class="field" wx:if="{{sec.hasCollapse}}">
      <text class="field__label">IVC 吸气塌陷</text>
      <view class="seg">
        <view wx:for="{{collapse}}" wx:key="v"
              class="seg__item {{collapseV === item.v ? 'seg__item--on' : ''}}"
              data-v="{{item.v}}" bindtap="onCollapse">{{item.n}}</view>
      </view>
    </view>

    <view class="vsum vsum--{{level}}">结果 · {{summary}}</view>

    <view class="vres">
      <view class="vres__r" wx:for="{{rows}}" wx:key="index">
        <text class="vres__k">{{item.k}}</text>
        <view class="vres__v">
          <text>{{item.v}}</text>
          <text wx:if="{{item.tag}}" class="lvl lvl--{{item.level}}">{{item.tag}}</text>
        </view>
      </view>
      <view class="vres__idle" wx:if="{{!rows.length}}">填入任一指标即可看到结果与分级</view>
    </view>

    <view class="note" wx:for="{{notes}}" wx:key="index">· {{item}}</view>

    <button class="clear-btn" bindtap="onClear">清空本瓣膜输入</button>
  </view>

  <view class="note note--strong">
    阈值来源：ASE 2017 原生瓣膜反流定量、ASE/EACVI 2017 主动脉瓣狭窄定量、ACC/AHA 2020 瓣膜病分期、
    ESC/EACTS 2025 瓣膜病管理。分级需多参数一致并注明心率与测量方法；本页仅供速查与学习，不构成诊断依据。
  </view>

</view>
