<view class="page-wrap">

  <view class="card">
    <view class="card__title">血流动力学计算</view>
    <view class="card__desc">
      BSA {{bsaText}} m²（来自「基本参数」页）· 箭头内径与 VTI 用于连续方程；
      各组结果独立计算，留空跳过。
    </view>
    <button class="valve-entry" bindtap="onGoValves">→ 瓣膜评估（AS / AR / MS / MR / TR）</button>
    <view class="note">AVA、MVA、PISA（EROA / RVol）、dP/dt 等瓣膜专项计算已整合到「瓣膜评估」页，与本页共享同一套引擎。</view>
  </view>

  <view wx:for="{{groups}}" wx:key="id" wx:for-item="g" wx:for-index="gi" class="card">
    <view class="card__title">{{g.title}}</view>

    <view wx:for="{{inputs}}" wx:key="key"
          wx:if="{{item.group === g.id}}"
          class="field">
      <text class="field__label">{{item.name}} / {{item.unit}}</text>
      <input class="field__input" type="digit" value="{{item.value}}"
             data-idx="{{index}}" bindinput="onInput" placeholder="未填写" />
    </view>

    <!-- 右心压力组的附加选项 -->
    <block wx:if="{{g.id === 'pressure'}}">
      <view class="field">
        <text class="field__label">IVC 吸气塌陷</text>
        <view class="seg">
          <view wx:for="{{collapse}}" wx:key="v"
                class="seg__item {{collapseV === item.v ? 'seg__item--on' : ''}}"
                data-v="{{item.v}}" bindtap="onCollapse">{{item.n}}</view>
        </view>
      </view>
      <view class="field">
        <text class="field__label">PH 支持征象（≥2 类）</text>
        <view class="seg">
          <view wx:for="{{signs}}" wx:key="v"
                class="seg__item {{signsV === item.v ? 'seg__item--on' : ''}}"
                data-v="{{item.v}}" bindtap="onSigns">{{item.n}}</view>
        </view>
      </view>
    </block>

    <view class="note">{{g.note}}</view>

    <view wx:if="{{outputs[g.id]}}" class="calc-out">
      <text class="calc-out__lbl">结果</text>
      <text class="calc-out__v">{{outputs[g.id]}}</text>
    </view>
    <view wx:else class="calc-out calc-out--idle">
      <text class="calc-out__lbl">结果</text>
      <text class="calc-out__v">等待输入</text>
    </view>
  </view>

  <button class="clear-btn" bindtap="onClear">清空全部输入</button>

  <view class="note note--strong">
    公式来源：ASE/EACVI 2015 定量指南、ESC/ERS 2022 肺高压指南、Hatle（MVA=220/PHT）、
    Abbas（PVR 经验公式）。本工具仅供速查与学习，不构成诊断依据。
  </view>

</view>
