<view class="page-wrap">

  <view class="card">
    <view class="card__title">公式集</view>
    <view class="card__desc">
      按主题分组，点击条目进入对应公式。{{countText}} · BSA {{bsaText}} m²（来自「EF·参考值」页）
    </view>
  </view>

  <!-- 搜索：条目较多，顶部常驻过滤 -->
  <view class="fx-search">
    <input class="fx-search__i" value="{{kw}}" type="text"
           placeholder="搜索公式 / 评估 / 视频，如 EF、TAPSE、房间隔"
           placeholder-class="fx-search__ph" confirm-type="search"
           bindinput="onSearch" />
    <view wx:if="{{kw}}" class="fx-search__x" bindtap="onClearSearch">✕</view>
  </view>

  <view wx:if="{{searching && sections.length === 0}}" class="fx-empty">
    没有匹配「{{kw}}」的条目
  </view>

  <!-- 组名快速跳转：平铺全部组名一眼看全（目录很长，点一下直接定位到该组） -->
  <view wx:if="{{navGroups.length}}" class="fx-nav">
    <view wx:for="{{navGroups}}" wx:key="id" wx:for-item="ng"
          class="fx-nav__c {{ng.id === curGroup ? 'fx-nav__c--on' : ''}}"
          data-id="{{ng.id}}" hover-class="fx-nav__c--tap" bindtap="onJumpGroup">{{ng.title}}</view>
  </view>

  <block wx:for="{{sections}}" wx:key="id" wx:for-item="sec">
    <view class="fx-group" id="g-{{sec.id}}">{{sec.title}}</view>
    <view wx:if="{{sec.note}}" class="fx-group__note">{{sec.note}}</view>

    <view class="fx-list">
      <view wx:for="{{sec.items}}" wx:key="id" wx:for-item="it"
            class="fx-item" hover-class="fx-item--tap"
            data-kind="{{it.kind}}" data-id="{{it.id}}" data-url="{{it.url}}"
            data-sec="{{it.sec}}" data-title="{{it.title}}" bindtap="onOpen">
        <view class="fx-item__main">
          <view class="fx-item__n">{{it.title}}</view>
          <view class="fx-item__d">{{it.sub}}</view>
        </view>
        <view class="fx-item__a">{{it.kind === 'album' ? it.count + ' ›' : (it.video ? '▶' : '›')}}</view>
      </view>
    </view>
  </block>

  <!-- ══════ 参考文献（默认折叠，点标题展开全部） ══════ -->
  <view class="card">
    <view class="card__title refs-hd {{refsOpen ? 'refs-hd--open' : ''}}"
          bindtap="onToggleRefs">
      <text class="refs-hd__t">参考文献</text>
      <text class="refs-hd__n">{{refsCount}} 条 · {{refsPdf}} 条附直链</text>
      <text class="refs-hd__a">›</text>
    </view>
    <view class="card__desc">
      本工具全部数据与分级标准的来源（含 ASE 官方指南 PDF 直链，切面指南已并入此处）。
      详情页底部会标注该条目使用的文献编号，点标题展开全部；点条目上的「PDF / 中文 PDF」
      复制链接，粘贴到手机浏览器即可打开。
    </view>

    <view wx:if="{{refsOpen}}">
      <view wx:for="{{refs}}" wx:key="id" class="ref-item">
        <view class="ref-item__id">{{item.id}}</view>
        <view class="ref-item__body">
          <view class="ref-item__zh">{{item.zh}}</view>
          <view class="ref-item__en">{{item.en}}</view>
          <view class="ref-item__where">{{item.where}}</view>
          <view class="ref-item__use">用于：{{item.use}}</view>
          <view wx:if="{{item.dl.length}}" class="ref-dl">
            <view wx:for="{{item.dl}}" wx:for-item="lk" wx:key="u"
                  class="ref-dl__i" hover-class="ref-dl__i--tap"
                  data-url="{{lk.u}}" catchtap="onCopyLink">{{lk.t}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ══════ 延展阅读（外部工具，复制链接到浏览器打开） ══════ -->
  <view class="card">
    <view class="card__title">延展阅读</view>
    <view class="card__desc">
      同类心超速查工具，内容更全。小程序内无法直接打开外部网页，点击条目复制链接，
      粘贴到手机浏览器即可访问。
    </view>

    <view wx:for="{{extLinks}}" wx:key="url" wx:for-item="it"
          class="extlink" hover-class="extlink--tap"
          data-url="{{it.url}}" bindtap="onCopyLink">
      <view class="extlink__main">
        <view class="extlink__name">{{it.name}}</view>
        <view class="extlink__desc">{{it.desc}}</view>
      </view>
      <view class="extlink__act">复制</view>
    </view>
  </view>

  <view class="verline">心脏超声参考值 · v{{appVersion}}</view>

  <view class="note note--strong">
    公式来源：ASE/EACVI 2015 定量指南、ESC/ERS 2022 肺高压指南、Hatle（MVA=220/PHT）、
    Abbas（PVR 经验公式）。本工具仅供速查与学习，不构成诊断依据。
  </view>

</view>
