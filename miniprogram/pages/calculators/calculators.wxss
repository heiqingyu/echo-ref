/* 公式集目录（入口列表） */

/* 搜索框：滚动时吸顶，避免翻长列表找条目 */
.fx-search {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(16, 32, 64, 0.06);
}

.fx-search__i {
  flex: 1;
  height: 60rpx;
  font-size: 27rpx;
  color: #1f2937;
}

.fx-search__ph {
  font-size: 26rpx;
  color: #a3aab5;
}

.fx-search__x {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9aa1ad;
}

/* 搜索无结果 */
.fx-empty {
  margin: 20rpx 0;
  padding: 48rpx 20rpx;
  border-radius: 18rpx;
  background: #fff;
  text-align: center;
  font-size: 26rpx;
  color: #8a9099;
}

.fx-group {
  margin: 28rpx 4rpx 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #6b7280;
  letter-spacing: 1rpx;
}

/* 分组说明（如书籍的编者 / 出版社 / ISBN） */
.fx-group__note {
  margin: 0 4rpx 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: #eef2f9;
  font-size: 22rpx;
  line-height: 1.6;
  color: #5b6472;
}

.fx-list {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(16, 32, 64, 0.04);
}

.fx-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.fx-item:last-child {
  border-bottom: none;
}

.fx-item--tap {
  background: #f2f7ff;
}

.fx-item__main {
  flex: 1;
  min-width: 0;
}

.fx-item__n {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.45;
}

.fx-item__d {
  font-size: 23rpx;
  color: #8a9099;
  margin-top: 4rpx;
  line-height: 1.5;
}

.fx-item__a {
  flex: none;
  font-size: 34rpx;
  color: #c4c9d1;
  line-height: 1;
}

/* ── 参考文献 ── */

/* 折叠头：默认收起，点标题展开全部 */
.refs-hd {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.refs-hd__n {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--sub);
}

.refs-hd__a {
  flex: none;
  font-size: 30rpx;
  line-height: 1;
  color: var(--sub);
  transition: transform .18s ease;
}

.refs-hd--open .refs-hd__a {
  transform: rotate(90deg);
}

.ref-item {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f1f3;
}

.ref-item:first-of-type {
  border-top: none;
}

.ref-item__id {
  flex: none;
  width: 64rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 600;
  color: #1d4ed8;
  background: #eff4ff;
  border-radius: 8rpx;
}

.ref-item__body {
  flex: 1;
  min-width: 0;
}

.ref-item__zh {
  font-size: 25rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.5;
}

.ref-item__en {
  font-size: 21rpx;
  color: #8a9099;
  margin-top: 4rpx;
  line-height: 1.5;
  word-break: break-word;
}

.ref-item__where {
  font-size: 21rpx;
  color: #6b7280;
  margin-top: 2rpx;
  line-height: 1.5;
}

.ref-item__use {
  font-size: 21rpx;
  color: #2563eb;
  margin-top: 4rpx;
  line-height: 1.5;
}

/* ── 参考文献末尾的版权声明（本站托管的指南 PDF） ── */
.refs-copy {
  margin: 18rpx 0 0;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(16, 32, 64, 0.04);
  font-size: 21rpx;
  line-height: 1.6;
  color: #6b7280;
}

/* ── 组名快速跳转（平铺全部组名，不再横向滑动） ── */
.fx-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  margin: 18rpx 0 12rpx;
  padding: 4rpx 0;
}

.fx-nav__c {
  flex: none;
  padding: 10rpx 22rpx;
  font-size: 23rpx;
  color: #4b5563;
  background: #f1f3f6;
  border-radius: 999rpx;
}

.fx-nav__c--on {
  color: #fff;
  background: #2563eb;
}

.fx-nav__c--tap {
  background: #dbe6ff;
}

/* 文献直链胶囊：点一下复制链接（ASE 官方 PDF / 中文 PDF / 免费全文） */
.ref-dl {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.ref-dl__i {
  padding: 6rpx 18rpx;
  font-size: 21rpx;
  color: #1d4ed8;
  background: #eff4ff;
  border: 1rpx solid #dbe6ff;
  border-radius: 999rpx;
}

.ref-dl__i--tap {
  background: #dbe6ff;
}

/* 「需订阅」不是免费直链：虚线灰边，与可下载的 PDF 明确区分 */
.ref-dl__i--sub {
  color: #6b7280;
  background: transparent;
  border: 1rpx dashed #cfd6df;
}

/* 回到顶部（目录很长，2026-10-21） */
.totop {
  position: fixed;
  right: 28rpx;
  bottom: 140rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .97);
  border: 1rpx solid #dbe3ec;
  color: #2563eb;
  font-size: 40rpx;
  line-height: 86rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, .16);
  z-index: 60;
}
