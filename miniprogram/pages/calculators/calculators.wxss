/* 公式集目录（入口列表） */

/* 搜索框：滚动时吸顶，避免翻长列表找条目 */
.fx-search {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(16, 32, 64, 0.06);
}

.fx-search__i {
  flex: 1;
  height: 60rpx;
  font-size: 27rpx;
  color: #1f2937;
}

.fx-search__ph {
  font-size: 26rpx;
  color: #a3aab5;
}

.fx-search__x {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9aa1ad;
}

/* 搜索无结果 */
.fx-empty {
  margin: 20rpx 0;
  padding: 48rpx 20rpx;
  border-radius: 18rpx;
  background: #fff;
  text-align: center;
  font-size: 26rpx;
  color: #8a9099;
}

/* 跨页签搜索提示（v1.6.5）：切面速查/视频/演示在「切面学习」页签，命中了给条入口 */
.fx-cross {
  margin: 0 0 16rpx;
  padding: 22rpx 24rpx;
  border: 1rpx dashed rgba(37, 99, 235, 0.35);
  border-radius: 16rpx;
  background: #eff4ff;
  font-size: 26rpx;
  color: #2563eb;
}

/* ★ v1.8.2 目录改版：一组一张卡，组头带竖色条 + 条目数，条目左侧缩写徽标
   好处：120 条不再是一张张浮动的小白卡，滚动时靠组块与徽标列定位 */
.fx-card {
  margin-bottom: 26rpx;
  border-radius: 18rpx;
  background: #fff;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(16, 32, 64, 0.05);
}

.fx-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 24rpx 18rpx;
  border-bottom: 1rpx solid #f0f2f7;
}

.fx-group {
  flex: 1;
  min-width: 0;
  padding-left: 14rpx;
  border-left: 6rpx solid #2563eb;
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2329;
  letter-spacing: 0.5rpx;
  line-height: 1.35;
}

.fx-hd__n {
  flex: none;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #f4f6fa;
  font-size: 21rpx;
  color: #98a1b0;
}

/* 分组说明（如书籍的编者 / 出版社 / ISBN） */
.fx-group__note {
  margin: 0;
  padding: 14rpx 24rpx;
  border-bottom: 1rpx solid #f0f2f7;
  background: #f7f9fd;
  font-size: 22rpx;
  line-height: 1.6;
  color: #5b6472;
}

.fx-list {
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
}

.fx-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f2f4f8;
}

.fx-item:last-child {
  border-bottom: none;
}

.fx-item--tap {
  background: #f2f7ff;
}

/* 缩写徽标：靠它一眼扫到条目，同组内等宽排成一条竖列 */
.fx-bd {
  flex: none;
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 4rpx;
  border-radius: 18rpx;
  background: #eef3fd;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.1;
  text-align: center;
  letter-spacing: -0.5rpx;
}

/* 5 个字符以上（MAPSE / Qp/Qs / Fontan…）降一档字号，避免在固定宽度里挤成一坨 */
.fx-bd--s {
  font-size: 19rpx;
  letter-spacing: -0.8rpx;
}

.fx-item__main {
  flex: 1;
  min-width: 0;
}

.fx-item__n {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.45;
}

.fx-item__d {
  font-size: 23rpx;
  color: #8a9099;
  margin-top: 4rpx;
  line-height: 1.5;
}

.fx-item__a {
  flex: none;
  font-size: 34rpx;
  color: #c4c9d1;
  line-height: 1;
}

/* 收藏星标（v1.7.7）：catchtap 独立命中区，点星不会打开条目 */
.fx-item__f {
  flex: none;
  padding: 6rpx 8rpx;
  font-size: 32rpx;
  line-height: 1;
  color: #c8ced8;
}

.fx-item__f--on {
  color: #e8a020;
}

.fx-item__f--tap {
  opacity: 0.55;
}

/* ── 参考文献 ── */

/* 折叠头：默认收起，点标题展开全部 */
.refs-hd {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.refs-hd__n {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: var(--sub);
}

.refs-hd__a {
  flex: none;
  font-size: 30rpx;
  line-height: 1;
  color: var(--sub);
  transition: transform .18s ease;
}

.refs-hd--open .refs-hd__a {
  transform: rotate(90deg);
}

.ref-item {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f1f3;
}

.ref-item:first-of-type {
  border-top: none;
}

/* 从条目详情跳过来时，目标文献闪一下（v1.11.3） */
.ref-item--hit {
  animation: refHit 2.6s ease;
}

@keyframes refHit {
  0%, 55% {
    background: #fff4d6;
    box-shadow: inset 0 0 0 4rpx #f3b73e;
  }
  100% {
    background: transparent;
    box-shadow: inset 0 0 0 4rpx transparent;
  }
}

.ref-item__id {
  flex: none;
  width: 64rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 600;
  color: #1d4ed8;
  background: #eff4ff;
  border-radius: 8rpx;
}

.ref-item__body {
  flex: 1;
  min-width: 0;
}

.ref-item__zh {
  font-size: 25rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.5;
}

.ref-item__en {
  font-size: 22rpx;
  color: #5d6673;
  margin-top: 4rpx;
  line-height: 1.55;
  word-break: break-word;
}

.ref-item__where {
  font-size: 22rpx;
  color: #2f3a4d;
  font-weight: 500;
  margin-top: 2rpx;
  line-height: 1.5;
}

.ref-item__use {
  font-size: 21rpx;
  color: #2563eb;
  margin-top: 4rpx;
  line-height: 1.5;
}

/* ── 参考文献末尾的版权声明（本站托管的指南 PDF） ── */
.refs-copy {
  margin: 18rpx 0 0;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(16, 32, 64, 0.04);
  font-size: 21rpx;
  line-height: 1.6;
  color: #6b7280;
}

/* ── 组名快速跳转（平铺全部组名，不再横向滑动） ── */
.fx-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  margin: 18rpx 0 12rpx;
  padding: 4rpx 0;
}

.fx-nav__c {
  flex: none;
  padding: 10rpx 22rpx;
  font-size: 23rpx;
  color: #4b5563;
  background: #f1f3f6;
  border-radius: 999rpx;
}

.fx-nav__c--on {
  color: #fff;
  background: #2563eb;
}

.fx-nav__c--tap {
  background: #dbe6ff;
}

/* 文献直链胶囊：点一下复制链接（ASE 官方 PDF / 中文 PDF / 免费全文） */
.ref-dl {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.ref-dl__i {
  padding: 6rpx 18rpx;
  font-size: 21rpx;
  color: #1d4ed8;
  background: #eff4ff;
  border: 1rpx solid #dbe6ff;
  border-radius: 999rpx;
}

.ref-dl__i--tap {
  background: #dbe6ff;
}

/* 「需订阅」不是免费直链：虚线灰边，与可下载的 PDF 明确区分 */
.ref-dl__i--sub {
  color: #6b7280;
  background: transparent;
  border: 1rpx dashed #cfd6df;
}

/* 回到顶部（目录很长，2026-10-21） */
.totop {
  position: fixed;
  right: 28rpx;
  bottom: 140rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .97);
  border: 1rpx solid #dbe3ec;
  color: #2563eb;
  font-size: 40rpx;
  line-height: 86rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, .16);
  z-index: 60;
}
