/* 公式集目录（入口列表） */

.fx-group {
  margin: 28rpx 4rpx 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #6b7280;
  letter-spacing: 1rpx;
}

/* 分组说明（如书籍的编者 / 出版社 / ISBN） */
.fx-group__note {
  margin: 0 4rpx 10rpx;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  background: #eef2f9;
  font-size: 22rpx;
  line-height: 1.6;
  color: #5b6472;
}

.fx-list {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(16, 32, 64, 0.04);
}

.fx-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.fx-item:last-child {
  border-bottom: none;
}

.fx-item--tap {
  background: #f2f7ff;
}

.fx-item__main {
  flex: 1;
  min-width: 0;
}

.fx-item__n {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.45;
}

.fx-item__d {
  font-size: 23rpx;
  color: #8a9099;
  margin-top: 4rpx;
  line-height: 1.5;
}

.fx-item__a {
  flex: none;
  font-size: 34rpx;
  color: #c4c9d1;
  line-height: 1;
}

/* ── 参考文献 ── */
.ref-item {
  display: flex;
  gap: 14rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f1f3;
}

.ref-item:first-of-type {
  border-top: none;
}

.ref-item__id {
  flex: none;
  width: 64rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 21rpx;
  font-weight: 600;
  color: #1d4ed8;
  background: #eff4ff;
  border-radius: 8rpx;
}

.ref-item__body {
  flex: 1;
  min-width: 0;
}

.ref-item__zh {
  font-size: 25rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.5;
}

.ref-item__en {
  font-size: 21rpx;
  color: #8a9099;
  margin-top: 4rpx;
  line-height: 1.5;
  word-break: break-word;
}

.ref-item__where {
  font-size: 21rpx;
  color: #6b7280;
  margin-top: 2rpx;
  line-height: 1.5;
}

.ref-item__use {
  font-size: 21rpx;
  color: #2563eb;
  margin-top: 4rpx;
  line-height: 1.5;
}

/* ── 延展阅读 ── */
.extlink {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  margin-top: 16rpx;
  background: #f7f9fc;
  border: 1rpx solid #e6ebf3;
  border-radius: 14rpx;
}

.extlink--tap {
  background: #eef4ff;
  border-color: #c7d9f5;
}

.extlink__main {
  flex: 1;
  min-width: 0;
}

.extlink__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.4;
}

.extlink__desc {
  font-size: 23rpx;
  color: #6b7280;
  margin-top: 4rpx;
  line-height: 1.5;
}

.extlink__act {
  flex: none;
  font-size: 23rpx;
  color: #2563eb;
  border: 1rpx solid #bcd3f7;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  background: #fff;
}
