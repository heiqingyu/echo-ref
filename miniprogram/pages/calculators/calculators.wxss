/* 公式集目录（入口列表） */

.fx-group {
  margin: 28rpx 4rpx 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #6b7280;
  letter-spacing: 1rpx;
}

.fx-list {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(16, 32, 64, 0.04);
}

.fx-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid #f0f1f3;
}

.fx-item:last-child {
  border-bottom: none;
}

.fx-item--tap {
  background: #f2f7ff;
}

.fx-item__main {
  flex: 1;
  min-width: 0;
}

.fx-item__n {
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.45;
}

.fx-item__d {
  font-size: 23rpx;
  color: #8a9099;
  margin-top: 4rpx;
  line-height: 1.5;
}

.fx-item__a {
  flex: none;
  font-size: 34rpx;
  color: #c4c9d1;
  line-height: 1;
}
