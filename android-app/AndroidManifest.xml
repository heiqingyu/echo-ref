<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.echoref.app"
    android:versionCode="1"
    android:versionName="1.0.0">

    <!--
      ★ 只申请一个权限：INTERNET
        页面本体是 assets 里的 index.html，完全离线；但「视频库」里 189 段演示短片
        是飞利浦 / 公开图库的 https 直链，必须在页内流式播放（v1.10.4 起不再甩给系统播放器）。
        v1.11.0 之前没这条权限，WebView 建不了 socket，点开视频只能报「仍在缓冲」——
        这是 v1.11.1 修掉的真实 bug。
        仍然不申请：存储 / 定位 / 相机 / 通讯录 / 通知。安装时只显示「网络访问」一项。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name="com.echoref.app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
